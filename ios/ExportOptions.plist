<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store Connect / TestFlight distribution. -->
	<key>method</key>
	<string>app-store-connect</string>

	<key>teamID</key>
	<string>4DX8JKBYV3</string>

	<!-- Let Xcode create and download the distribution profile rather than
	     pinning one by name. Requires an Apple ID signed in to Xcode, or an
	     App Store Connect API key passed to xcodebuild. -->
	<key>signingStyle</key>
	<string>automatic</string>

	<!-- Bitcode has been dead since Xcode 14; leaving it on breaks newer SDKs. -->
	<key>uploadBitcode</key>
	<false/>

	<!-- Symbols make TestFlight crash reports readable instead of hex soup.
	     Worth it for a prototype you actually want feedback from. -->
	<key>uploadSymbols</key>
	<true/>

	<key>stripSwiftSymbols</key>
	<true/>

	<!-- Thin per-device rather than shipping every architecture to everyone. -->
	<key>thinning</key>
	<string>&lt;thin-for-all-variants&gt;</string>

	<key>destination</key>
	<string>export</string>
</dict>
</plist>
